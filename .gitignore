# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored skills from `npx skills add Leonxlnx/taste-skill` — installed per
# machine, not part of the app. `.agents/skills/` holds the skill files,
# `.claude/skills/` the symlinks Claude Code reads them through, and
# skills-lock.json pins the versions. Reinstall with the command above rather
# than committing ~13 third-party skill bundles into this repo.
.agents/
.claude/skills/
skills-lock.json

# private notes — resume / portfolio / interview prep, not repo content
docs/resume-refund-agent.md
